  "7521351916384145408": {
   "created": 1793230036,
   "author": "Anshuman Satpute",
   "url": "https://www.linkedin.com/posts/anshumansatpute_etched-artificialintelligence-aiinfrastructure-activity-7521351916384145408-4gn0",
   "text": "I recently had the opportunity to attend Etched\u2019s Fireside Chat: Hardware-Software Codesign for Gigawatt Scale!\n\nIt was a great opportunity to learn more about the infrastructure behind AI and how hardware and software work together to optimize inference performance.\n\nAs someone who finds this field interesting, Understanding the engineering challenges and tradeoffs involved in scaling AI was pretty fun!\n\nExcited to keep learning more about this space!\n\n#Etched #ArtificialIntelligence #AIInfrastructure",
   "disc_score": 1,
