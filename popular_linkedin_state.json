   "miss": 0,
   "added": 1790875644
  },
  "7511425250149154816": {
   "created": 1790863335,
   "author": "Smitha K.",
   "url": "https://www.linkedin.com/posts/activity-7511425250149154816-jQx7",
   "text": "A proud mom moment! \u2764\ufe0f From a summer internship at NVIDIA to ETCHED (an AI chip startup) as a thermal engineer, keeping chips cool while your career heats up! \ud83d\ude09 So proud of your hard work and the sincerity and dedication you bring to everything you do, Yaamini J.. A busy few months lie ahead with your internship and final semester, and I\u2019ll be cheering you on through it all. Excited to see you learn, grow, and accomplish new things and can\u2019t wait to see you graduate!\ud83d\udc69\u200d\ud83c\udf93 Go Bears! \ud83d\udc99\ud83d\udc9b",
   "disc_score": 8,
